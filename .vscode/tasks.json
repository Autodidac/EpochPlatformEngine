{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EpochPlatformEngine: CMake configure Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "ninja-debug"],
      "problemMatcher": []
    },
    {
      "label": "EpochPlatformEngine: CMake build Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "ninja-debug"],
      "dependsOn": "EpochPlatformEngine: CMake configure Debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "EpochPlatformEngine: CMake test Debug",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "ninja-debug"],
      "dependsOn": "EpochPlatformEngine: CMake build Debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "EpochPlatformEngine: direct native build",
      "type": "shell",
      "command": "${workspaceFolder}/build.sh gcc Debug",
      "windows": {
        "command": "cmd /d /c \"${workspaceFolder}\\build.bat\" Debug"
      },
      "group": "build",
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "EpochPlatformEngine: direct Clang build",
      "type": "shell",
      "command": "${workspaceFolder}/build.sh clang Debug",
      "windows": {
        "command": "cmd /d /c \"${workspaceFolder}\\build.bat\" Debug"
      },
      "group": "build",
      "problemMatcher": ["$gcc", "$msCompile"]
    }
  ]
}
